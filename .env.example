# Keep this file on the backend host. Never commit a populated .env.
BACKEND_API_TOKEN=replace-with-a-long-random-token
GEMINI_API_KEY=
# Select a generateContent-compatible model enabled for your account.
GEMINI_MODEL=
HF_TOKEN=
ALLOWED_ORIGINS=http://localhost:8000,https://advohq-case-research.pearly-cod-0783.chatgpt.site
INDEX_MODE=owned
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
QDRANT_COLLECTION=advohq_gemini_768
QDRANT_API_KEY=
# Only needed when reusing Vaquill snapshots:
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4
SNAPSHOT_RELEASE=v2026.08.1
SNAPSHOT_COURT_FIELD=court

# Slows bulk embedding; query requests do not use this delay.
EMBEDDING_INTERVAL_SECONDS=4
